# Optional: Google Gemini API Key for LLM-powered live evaluations
# If omitted, the engine uses the built-in intelligent Sales Coach rule engine.
# You can also set this in the in-app Admin > Settings page.
GEMINI_API_KEY=

# Cloudflare D1 is provisioned via the `DB` binding in wrangler.jsonc when
# deployed to Cloudflare Workers — no credentials are needed here.
# Local development uses SQLite (sales_coach.db) automatically out of the box.

# Clerk Authentication & RBAC
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is public and must be present at BUILD time
# so it is inlined into the client bundle. CLERK_SECRET_KEY is secret — never
# commit it; in production it is set as a Cloudflare Worker secret
# (`wrangler secret put CLERK_SECRET_KEY`).
#
# Roles: Organization admins (`org:admin`) have full access. Organization members
# (`org:member`) are restricted to call uploads & scoring. You can also set
# user publicMetadata: { "role": "admin" } when no organization is active.
#
# Enable Organizations in Clerk Dashboard → Organizations → Settings, then
# create a workspace from the in-app team switcher and invite teammates
# from Admin → Settings.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/app/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/app/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
