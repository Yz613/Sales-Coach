# Clerk authentication (populated by `clerk init` / `clerk env pull`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Optional: Google Gemini API Key for LLM-powered live evaluations
# If omitted, the engine uses the built-in intelligent Sales Coach rule engine.
GEMINI_API_KEY=

# Cloudflare D1 Database (when deploying to Cloudflare Pages/Workers)
# Local development uses SQLite (sales_coach.db) automatically out of the box.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
