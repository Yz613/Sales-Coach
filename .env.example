# ==============================================================================
# Sales Coach AI — Environment Configuration
# ==============================================================================
#
# QUICKSTART (STANDALONE MODE):
# You can run Sales Coach locally right out of the box without any keys!
# The app automatically runs in "Local Admin Mode" using local SQLite (sales_coach.db).
# You can test transcripts immediately using the built-in deterministic rubric engine.
#
# To add AI evaluation / transcription or enable multi-user authentication, copy
# this file to `.env.local` (for local Next.js dev) or `.dev.vars` (for Cloudflare dev).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI PROVIDERS (Set here or in the UI at Admin → Settings)
# ------------------------------------------------------------------------------
# Supported providers: Google Gemini, OpenAI, Groq, Anthropic, DeepSeek, OpenRouter.
# Audio file uploads (MP3, WAV, M4A) require Gemini, OpenAI, or Groq for transcription.
# Pasted transcripts work with any configured provider, or with the built-in rubric engine.

GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION & MULTI-TENANT RBAC (Required in production)
# ------------------------------------------------------------------------------
# Without keys, only loopback local development has admin access.
# Production rejects workspace requests without both Clerk keys, an HTTPS PUBLIC_APP_URL,
# and a 32-byte INTEGRATION_ENCRYPTION_KEY.
# If you want multi-user authentication, team workspaces, and role-based access control:
# 1. Sign up for a free account at https://clerk.com
# 2. Create an application and enable Organizations (Clerk Dashboard → Organizations → Settings)
# 3. Paste your API keys below:

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Route Defaults (Scoped to /app basePath)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/app/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/app/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app/subscribe

# Hosted Clerk deployments require Stripe Checkout before sign-up.
# Self-host with Clerk for team RBAC only: set BILLING_REQUIRED=false.
# BILLING_REQUIRED=true
#
# If historical (pre-isolation) rows should belong to a specific Clerk org:
# LEGACY_TENANT_ORG_ID=org_...

# ------------------------------------------------------------------------------
# 3. STRIPE BILLING (Hosted Coach / Hosted Team)
# ------------------------------------------------------------------------------
# New hosted customers pay on Stripe before they reach Clerk sign-up.
# Create a restricted secret key plus a webhook on /app/api/webhooks/stripe.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_COACH=
# STRIPE_PRICE_TEAM=

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL (Optional — for teammate invites)
# ------------------------------------------------------------------------------
# Send teammate invitations via Resend (can also be configured at Admin → Settings).
# Leave RESEND_FROM_EMAIL empty until the address is on a domain you verified in Resend.
# example.com is rejected. Do not use invites@refreshqueue.com — that mailbox is the hosted site only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# RESEND_FROM_EMAIL="Sales Coach <invites@example.com>"
INVITE_PRODUCT_NAME="Sales Coach"

# ------------------------------------------------------------------------------
# 5. DATABASE & CLOUDFLARE WORKERS (Optional)
# ------------------------------------------------------------------------------
# Local development uses SQLite (`sales_coach.db`) automatically — zero setup required.
# In Cloudflare Workers production, D1 is provisioned via wrangler.jsonc.

# Required in production: create 32 random bytes as base64 for credentials and recordings.
# Local development creates data/integration.key automatically; keep it separate from database backups.
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_CRON_SECRET=
PUBLIC_APP_URL=
# SALES_COACH_DB_PATH=data/sales_coach.db
# INTEGRATION_KEY_FILE=data/integration.key

# Optional company lookup for product analytics. Leave both blank to use the
# network owner name only. Server-side only. See workflow-contract.md for the
# optional VISITOR_COMPANY_KV binding. Do not put these on the landing page.
# IPINFO_TOKEN=
# IPAPI_KEY=

# Production requires a verified second factor within the last eight hours by default.
# Enable MFA in the Clerk dashboard and enroll each user before production rollout.
# Set true to enforce the same requirement during development.
REQUIRE_MFA=true

# ------------------------------------------------------------------------------
# 6. CALENDAR SIGN-IN (Optional — register web OAuth applications first)
# ------------------------------------------------------------------------------
# Register redirect URLs using your PUBLIC_APP_URL and the paths listed in
# docs/INTEGRATION_SETUP.md. These are operator app credentials, not customer tokens.
# Restart the app and background worker after changing them. Cloudflare needs runtime secrets.
# Local Calendly Sandbox callbacks use http://localhost:3000 (not 127.0.0.1).
# Google: enable Calendar API, web application, calendar.readonly permission.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Google Meet can use its own Web client. When unset, it reuses GOOGLE_CLIENT_ID
# (the Gmail client) and then the Calendar client above. Enable the Google Meet API,
# Google Drive API, and People API. Scopes: meetings.space.readonly, drive.meet.readonly,
# contacts.readonly, and userinfo.email. Callback: /app/api/integrations/oauth/google-meet/callback
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
# Microsoft: multi-tenant web application, delegated User.Read, Calendars.Read, offline_access.
# Use the client secret Value, not the Secret ID.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Calendly: public OAuth app with users:read and scheduled_events:read.
# Customers can also connect their own account with a personal access token.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=

# Asana, Notion, Trello, ClickUp, monday.com, Linear, Todoist, Airtable,
# GitHub, GitLab and Discord credentials are entered in Admin → Integrations.
# These connectors do not need extra operator OAuth environment variables.
# See docs/TASK_INTEGRATIONS.md for destination IDs, permissions and verification.

# One-time provider app credentials enable customer account sign-in.
# Callback: https://your-domain/app/api/integrations/oauth/<provider>/callback

# HubSpot (hubspot)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Pipedrive (pipedrive)
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

# Attio (attio)
ATTIO_CLIENT_ID=
ATTIO_CLIENT_SECRET=

# Asana (asana)
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# Notion (notion)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ClickUp (clickup)
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=

# monday.com (monday)
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=

# Linear (linear)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Todoist (todoist)
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Airtable (airtable)
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=

# GitHub (github)
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=

# GitLab (gitlab)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Slack (slack)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Discord (discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Zoom (zoom) — user-managed General App, cloud recording read scopes. Not a meeting bot.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Microsoft Teams (microsoft-teams). Falls back to MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET when unset.
# Delegated scopes: offline_access, User.Read, Calendars.Read, OnlineMeetings.Read,
# OnlineMeetingTranscript.Read.All, OnlineMeetingRecording.Read.All.
# The two .Read.All permissions need Microsoft 365 admin consent. Use the common endpoint.
MICROSOFT_TEAMS_CLIENT_ID=
MICROSOFT_TEAMS_CLIENT_SECRET=
