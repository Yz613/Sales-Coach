{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "cloudflare/worker.js",
	"name": "sales-coach",
	// "account_id": "<YOUR_CLOUDFLARE_ACCOUNT_ID>",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"triggers": { "crons": ["*/5 * * * *"] },
	// One zone route so every path on the apex reaches this worker, including
	// `/?utm_source=...`. Path-specific routes left query-string URLs on the old static site.
	// No www route: www.refreshqueue.com is not configured here.
	// Production config lives outside this repo. Apply the same single pattern there.
	"routes": [
		{ "pattern": "refreshqueue.com/*", "zone_name": "refreshqueue.com" }
	],
	// Set NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in the build environment. GitHub
	// Actions reads it from repository secrets. The Clerk secret key is set
	// separately via `wrangler secret put CLERK_SECRET_KEY`.
	// Stripe: `wrangler secret put STRIPE_SECRET_KEY` and
	// `wrangler secret put STRIPE_WEBHOOK_SECRET`. Optional price ids can be vars.
	// Optional invite mailer: `wrangler secret put RESEND_API_KEY` (or paste it in
	// Admin → Settings).
	"vars": {
		"REQUIRE_MFA": "true",
		"NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/app/sign-in",
		"NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/app/sign-up",
		"NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/app",
		"NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/app/subscribe",
		"NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL": "/app/sign-in",
		"NEXT_PUBLIC_CLERK_PROXY_URL": "/app/__auth",
		"NEXT_PUBLIC_CLERK_JS_URL": "/app/__auth/assets/session@6/sdk.js",
		"NEXT_PUBLIC_CLERK_UI_URL": "/app/__auth/assets/interface@1/ui.js",
		"NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED": "true",
		"BILLING_REQUIRED": "true",
		"INVITE_PRODUCT_NAME": "Sales Coach",
		"RESEND_FROM_EMAIL": "Sales Coach <invites@refreshqueue.com>"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		"run_worker_first": [
			"/app/__auth",
			"/app/__auth/*",
			"/__auth",
			"/__auth/*",
			"/__clerk",
			"/__clerk/*"
		]
	},
	"ai": {
		"binding": "AI"
	},
	// Optional company lookup (a network organization, never a person).
	// Do not commit a namespace id. Hosted deploys inject VISITOR_COMPANY_KV in CI.
	// Self-hosters can omit it (in-memory cache) or add their own namespace:
	//   npx wrangler kv namespace create VISITOR_COMPANY_KV
	//   then add: "kv_namespaces": [{ "binding": "VISITOR_COMPANY_KV", "id": "<id from create>" }]
	// Optional secrets, both unset today. With neither, the route uses the network owner name:
	//   npx wrangler secret put IPINFO_TOKEN
	//   npx wrangler secret put IPAPI_KEY
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sales-coach-db",
			// Create with: npx wrangler d1 create sales-coach-db
			"database_id": "your-d1-database-id"
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "sales-coach"
		}
	],
	"r2_buckets": [
		{ "binding": "CALL_RECORDINGS", "bucket_name": "sales-coach-recordings" },
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Create the bucket before deploying
			// You can change the bucket name if you want
			// See https://developers.cloudflare.com/workers/wrangler/commands/#r2-bucket-create
			"bucket_name": "sales-coach-opennext-cache"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
