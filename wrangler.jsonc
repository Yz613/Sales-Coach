{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "cloudflare/worker.js",
	"name": "sales-coach",
	// "account_id": "<YOUR_CLOUDFLARE_ACCOUNT_ID>",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	// Optional custom domain routes (replace with your domain if deploying to Cloudflare Workers).
	// Apex `/` and `/pricing` must reach this worker so the marketing landing is not a 404.
	// "routes": [
	// 	{ "pattern": "yourdomain.com", "zone_name": "yourdomain.com" },
	// 	{ "pattern": "yourdomain.com/", "zone_name": "yourdomain.com" },
	// 	{ "pattern": "yourdomain.com/pricing", "zone_name": "yourdomain.com" },
	// 	{ "pattern": "yourdomain.com/app", "zone_name": "yourdomain.com" },
	// 	{ "pattern": "yourdomain.com/app/*", "zone_name": "yourdomain.com" },
	// 	{ "pattern": "yourdomain.com/calls", "zone_name": "yourdomain.com" },
	// 	{ "pattern": "yourdomain.com/calls/*", "zone_name": "yourdomain.com" },
	// 	{ "pattern": "yourdomain.com/favicon.ico", "zone_name": "yourdomain.com" },
	// 	{ "pattern": "yourdomain.com/icon.svg", "zone_name": "yourdomain.com" }
	// ],
	// Non-secret Clerk config (publishable key is public). The secret key is set
	// separately via `wrangler secret put CLERK_SECRET_KEY` and is NOT committed.
	// Stripe: `wrangler secret put STRIPE_SECRET_KEY` and
	// `wrangler secret put STRIPE_WEBHOOK_SECRET`. Optional price ids can be vars.
	// Optional invite mailer: `wrangler secret put RESEND_API_KEY` (or paste it in
	// Admin → Settings).
	"vars": {
		"NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "",
		"NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/app/sign-in",
		"NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/app/sign-up",
		"NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/app",
		"NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/app/subscribe",
		"NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL": "/app/sign-in",
		"BILLING_REQUIRED": "true"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sales-coach-db",
			// Create with: npx wrangler d1 create sales-coach-db
			"database_id": "your-d1-database-id"
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "sales-coach"
		}
	],
	"r2_buckets": [
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Create the bucket before deploying
			// You can change the bucket name if you want
			// See https://developers.cloudflare.com/workers/wrangler/commands/#r2-bucket-create
			"bucket_name": "sales-coach-opennext-cache"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}